# Public project URL; safe to expose to the browser runtime.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SERVER-ONLY. Never prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# SERVER-ONLY key used by /research and /api/research/summary.
RESEARCH_DASHBOARD_KEY=choose-a-long-random-research-key
